@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var dir = CurrentSite.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
    var homePage = CurrentSite.GetItem().PageHome;
}
<!DOCTYPE html>
<html lang="@CurrentSite.CurrentCulture.TwoLetterISOLanguageName" dir="@dir">
<head>
    @{
        await Html.RenderPartialAsync(PathFileViews.Partials_MetaData);
        await Html.RenderPartialAsync(PathFileViews.Partials_HtmlManage, nameof(GlobalPageScriptSetting.HeaderOpeningScripts));
    }
    @* Preconnect to font origins before any stylesheet requests them *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Preload LCP image (hero banner) — browser discovers it immediately instead of
       waiting for CSS to parse. This is the single biggest LCP improvement. *@
    @{
        var lcpImage = homePage?.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("backgroundImage");
        if (lcpImage != null)
        {
            var lcpUrl = lcpImage.GetCropUrl(width: 1920, quality: 75, furtherOptions: "&format=WebP");
            <link rel="preload" href="@lcpUrl" as="image" type="image/webp" fetchpriority="high">
        }
    }
    @* Google Fonts loaded async: media="print" trick defers download until after paint *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,400;0,700;0,900;1,400&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,400;0,700;0,900;1,400&display=swap"></noscript>
    @* Critical CSS inlined from file to eliminate render-blocking round-trip *@
    <style>@Html.Raw(uTPro.Extension.FileHelper.CriticalCssHelper.Get("css/uTPro/critical.css"))</style>
    <link rel="stylesheet" href="/assets/css/blockgridlayout.css" />
    <link rel="stylesheet" href="/css/uTPro/variables.css" />
    <link rel="stylesheet" href="/css/uTPro/layout.css" />
    <link rel="stylesheet" href="/css/uTPro/main.css" />
    @* Icon CSS loaded async — FontAwesome icons are below the fold *@
    <link rel="stylesheet" href="/css/uTPro/icon.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/css/uTPro/icon.css"></noscript>
    @RenderSection("Styles", false)
    @Html.RenderSections(HtmlSectionBlockExtensions.Position.Head)
    @{
        await Html.RenderPartialAsync(PathFileViews.Partials_HtmlManage, nameof(GlobalPageScriptSetting.HeaderClosingScripts));
    }
</head>
<body class="bodypage is-preload">
    @Html.RenderSections(HtmlSectionBlockExtensions.Position.BodyTop)
    @{
        await Html.RenderPartialAsync(PathFileViews.Partials_HtmlManage, nameof(GlobalPageScriptSetting.BodyOpeningScripts));
        await Html.RenderPartialAsync("_Nav.cshtml");
    }
    <main class="page-wrapper">
        @RenderBody()
        @{
            await Html.RenderPartialAsync("Copyright.cshtml");
        }
    </main>
    <script>window.lstRenderScriptQueue = [@Html.RenderScriptQueue()];</script>
    <script src="/scripts/uTPro/init.js" defer></script>
    @RenderSection("Scripts", false)
    @Html.RenderStandaloneScripts()
    @{
        await Html.RenderPartialAsync(PathFileViews.Partials_HtmlManage, nameof(GlobalPageScriptSetting.BodyClosingScripts));
    }
    @Html.RenderSections(HtmlSectionBlockExtensions.Position.BodyBottom)
</body>
</html>
