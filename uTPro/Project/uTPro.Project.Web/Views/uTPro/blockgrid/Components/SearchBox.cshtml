@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<UTpro__SearchBox>>
@{

}
<section class="container box">
    @if (!string.IsNullOrEmpty(Model.Content.Header))
    {
        <header>
            <h2>@Model.Content.Header</h2>
        </header>
    }
    <form method="get" class="row gtr-0" action="@Model.Content.SearchResultPage?.Url()">
        <div class="col-10 col-10-small">
            <input type="text" name="@(string.IsNullOrEmpty(Model.Content.SearchParameter) ? "q" : Model.Content.SearchParameter)" placeholder="Tìm kiếm">
        </div>
        <div class="col-2 col-2-small">
            <button class="style1 search-box-btn" type="submit">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <path d="M21 21l-4.35-4.35" />
                </svg>
            </button>
        </div>
    </form>
</section>