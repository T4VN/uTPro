    {
      "contentTypeKey": "7933a097-e795-4929-9746-d802b4ed8595",
      "key": "b1000002-2002-4000-a002-000000000002",
      "values": [
        {
          "alias": "thumbnail",
          "culture": "en-US",
          "editorAlias": null,
