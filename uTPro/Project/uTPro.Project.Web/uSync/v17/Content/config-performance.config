    <content>
      <Value Culture="en-US"><![CDATA[{"contentData":[{"contentTypeKey":"4b83a788-622b-4210-afad-eac8988de0dd","key":"a2f30003-1001-4000-b003-000000000003","values":[{"alias":"backgroundColor","culture":"en-US","editorAlias":null,"segment":null,"value":{"label":"","value":"#fff"}},{"alias":"backgroundOpacity","culture":"en-US","editorAlias":null,"segment":null,"value":"1"},{"alias":"title","culture":"en-US","editorAlias":null,"segment":null,"value":""}]},{"contentTypeKey":"7933a097-e795-4929-9746-d802b4ed8595","key":"a2f30003-2001-4000-b003-000000000003","values":[{"alias":"thumbnail","culture":"en-US","editorAlias":null,"segment":null,"value":[]},{"alias":"description","culture":"en-US","editorAlias":null,"segment":null,"value":"Minification, compression, multi-layer caching, Razor and request buffering"},{"alias":"title","culture":"en-US","editorAlias":null,"segment":null,"value":"Performance \u0026 Caching"},{"alias":"content","culture":"en-US","editorAlias":null,"segment":null,"value":{"contentData":[{"contentTypeKey":"be80a795-b398-4baa-860a-ee68b7124f11","key":"a2f30003-3001-4000-b003-000000000003","values":[{"alias":"richtext","culture":"en-US","editorAlias":null,"segment":null,"value":{"blocks":{"contentData":[],"settingsData":[],"expose":[],"layout":{}},"markup":"\u003Ch2\u003EPerformance \u0026 Caching\u003C/h2\u003E\u003Ch3\u003EMinification \u0026 Compression\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003EWebOptimizer\u003C/strong\u003E: CSS/JS minification for all site assets\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EWebMarkupMin\u003C/strong\u003E: HTML minification + Brotli/GZip/Deflate compression (Brotli prioritized)\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EPipeline order\u003C/strong\u003E: UseWebOptimizer() \u2192 UseStaticFiles() \u2192 UseWebMarkupMin() (critical for minification to work)\u003C/li\u003E\u003C/ul\u003E\u003Ch3\u003ECaching (multi-layer)\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003EOutput Cache\u003C/strong\u003E: Stores fully-rendered HTML in memory. Page policy = 120s TTL, Sitemap = 30min\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EBrowser Cache\u003C/strong\u003E: public, max-age=120, stale-while-revalidate=60\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EStatic File Cache\u003C/strong\u003E: /assets/, /css/, /scripts/ \u2192 1 year immutable; /uploads/ \u2192 7 days\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003ESitemap Memory Cache\u003C/strong\u003E: 30 minutes in IMemoryCache\u003C/li\u003E\u003C/ul\u003E\u003Ch3\u003ERazor\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003ERuntime Compilation\u003C/strong\u003E: Only in Development (saves ~200MB RAM in production)\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EPrecompiled views\u003C/strong\u003E: RazorCompileOnBuild=true\u003C/li\u003E\u003C/ul\u003E\u003Ch3\u003ERequest Buffering\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003EGlobal buffering disabled\u003C/strong\u003E: BufferBody = false\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003ESelective buffering\u003C/strong\u003E: Only endpoints that need to re-read the body enable it\u003C/li\u003E\u003C/ul\u003E"}}]}],"settingsData":[],"expose":[{"contentKey":"a2f30003-3001-4000-b003-000000000003","culture":"en-US","segment":null}],"layout":{"Umbraco.BlockList":[{"contentKey":"a2f30003-3001-4000-b003-000000000003","contentUdi":null,"settingsKey":null,"settingsUdi":null}]}}}]}],"settingsData":[{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"a2f30003-4001-4000-b003-000000000003","values":[{"alias":"addStyleSpacing","culture":"en-US","editorAlias":null,"segment":null,"value":["Remove Spacing"]}]},{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"a2f30003-5001-4000-b003-000000000003","values":[]}],"expose":[{"contentKey":"a2f30003-1001-4000-b003-000000000003","culture":"en-US","segment":null},{"contentKey":"a2f30003-2001-4000-b003-000000000003","culture":"en-US","segment":null}],"layout":{"Umbraco.BlockGrid":[{"areas":[{"items":[{"areas":[],"columnSpan":12,"contentKey":"a2f30003-2001-4000-b003-000000000003","contentUdi":null,"rowSpan":1,"settingsKey":"a2f30003-5001-4000-b003-000000000003","settingsUdi":null}],"key":"74341b8e-afe1-47c5-bd24-d94b157e8a1c"}],"columnSpan":12,"contentKey":"a2f30003-1001-4000-b003-000000000003","contentUdi":null,"rowSpan":1,"settingsKey":"a2f30003-4001-4000-b003-000000000003","settingsUdi":null}]}}]]></Value>
      <Value Culture="vi-VN"><![CDATA[{"contentData":[{"contentTypeKey":"4b83a788-622b-4210-afad-eac8988de0dd","key":"d1f20003-1001-4000-b003-000000000001","values":[{"alias":"backgroundColor","culture":"vi-VN","editorAlias":null,"segment":null,"value":{"label":"","value":"#fff"}},{"alias":"backgroundOpacity","culture":"vi-VN","editorAlias":null,"segment":null,"value":"1"},{"alias":"title","culture":"vi-VN","editorAlias":null,"segment":null,"value":""}]},{"contentTypeKey":"7933a097-e795-4929-9746-d802b4ed8595","key":"d1f20003-2001-4000-b003-000000000001","values":[{"alias":"thumbnail","culture":"vi-VN","editorAlias":null,"segment":null,"value":[]},{"alias":"description","culture":"vi-VN","editorAlias":null,"segment":null,"value":"N\u00E9n, cache \u0111a t\u1EA7ng, Razor v\u00E0 request buffering"},{"alias":"title","culture":"vi-VN","editorAlias":null,"segment":null,"value":"Hi\u1EC7u su\u1EA5t \u0026 Cache"},{"alias":"content","culture":"vi-VN","editorAlias":null,"segment":null,"value":{"contentData":[{"contentTypeKey":"be80a795-b398-4baa-860a-ee68b7124f11","key":"d1f20003-3001-4000-b003-000000000001","values":[{"alias":"richtext","culture":"vi-VN","editorAlias":null,"segment":null,"value":{"blocks":{"contentData":[],"settingsData":[],"expose":[],"layout":{}},"markup":"\u003Ch2\u003EHi\u1EC7u su\u1EA5t \u0026 Cache\u003C/h2\u003E\u003Ch3\u003EN\u00E9n \u0026 Minification\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003EWebOptimizer\u003C/strong\u003E: N\u00E9n CSS/JS cho t\u1EA5t c\u1EA3 assets\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EWebMarkupMin\u003C/strong\u003E: N\u00E9n HTML + Brotli/GZip/Deflate (\u01B0u ti\u00EAn Brotli)\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003ETh\u1EE9 t\u1EF1 Pipeline\u003C/strong\u003E: UseWebOptimizer() \u2192 UseStaticFiles() \u2192 UseWebMarkupMin()\u003C/li\u003E\u003C/ul\u003E\u003Ch3\u003ECache (\u0111a t\u1EA7ng)\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003EOutput Cache\u003C/strong\u003E: L\u01B0u HTML \u0111\u00E3 render trong memory. Page = 120s TTL, Sitemap = 30 ph\u00FAt\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EBrowser Cache\u003C/strong\u003E: public, max-age=120, stale-while-revalidate=60\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EStatic File Cache\u003C/strong\u003E: /assets/, /css/, /scripts/ \u2192 1 n\u0103m immutable; /uploads/ \u2192 7 ng\u00E0y\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003ESitemap Memory Cache\u003C/strong\u003E: 30 ph\u00FAt trong IMemoryCache\u003C/li\u003E\u003C/ul\u003E\u003Ch3\u003ERazor\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003ERuntime Compilation\u003C/strong\u003E: Ch\u1EC9 b\u1EADt trong Development (ti\u1EBFt ki\u1EC7m ~200MB RAM production)\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003EPrecompiled views\u003C/strong\u003E: RazorCompileOnBuild=true\u003C/li\u003E\u003C/ul\u003E\u003Ch3\u003ERequest Buffering\u003C/h3\u003E\u003Cul\u003E\u003Cli\u003E\u003Cstrong\u003EGlobal buffering t\u1EAFt\u003C/strong\u003E: BufferBody = false\u003C/li\u003E\u003Cli\u003E\u003Cstrong\u003ESelective buffering\u003C/strong\u003E: Ch\u1EC9 endpoint c\u1EA7n re-read body m\u1EDBi b\u1EADt\u003C/li\u003E\u003C/ul\u003E"}}]}],"settingsData":[],"expose":[{"contentKey":"d1f20003-3001-4000-b003-000000000001","culture":"vi-VN","segment":null}],"layout":{"Umbraco.BlockList":[{"contentKey":"d1f20003-3001-4000-b003-000000000001","contentUdi":null,"settingsKey":null,"settingsUdi":null}]}}}]}],"settingsData":[{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"d1f20003-4001-4000-b003-000000000001","values":[{"alias":"addStyleSpacing","culture":"vi-VN","editorAlias":null,"segment":null,"value":["Remove Spacing"]}]},{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"d1f20003-5001-4000-b003-000000000001","values":[]}],"expose":[{"contentKey":"d1f20003-1001-4000-b003-000000000001","culture":"vi-VN","segment":null},{"contentKey":"d1f20003-2001-4000-b003-000000000001","culture":"vi-VN","segment":null}],"layout":{"Umbraco.BlockGrid":[{"areas":[{"items":[{"areas":[],"columnSpan":12,"contentKey":"d1f20003-2001-4000-b003-000000000001","contentUdi":null,"rowSpan":1,"settingsKey":"d1f20003-5001-4000-b003-000000000001","settingsUdi":null}],"key":"74341b8e-afe1-47c5-bd24-d94b157e8a1c"}],"columnSpan":12,"contentKey":"d1f20003-1001-4000-b003-000000000001","contentUdi":null,"rowSpan":1,"settingsKey":"d1f20003-4001-4000-b003-000000000001","settingsUdi":null}]}}]]></Value>
