    },
    {
      "contentTypeKey": "7933a097-e795-4929-9746-d802b4ed8595",
      "key": "34567890-bcde-f012-3456-789abcdef012",
      "values": [
        {
          "alias": "title",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": "Ch\u00EDnh s\u00E1ch B\u1EA3o m\u1EADt"
        },
        {
          "alias": "content",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "be80a795-b398-4baa-860a-ee68b7124f11",
                "key": "76543210-edcb-a098-7654-321fedcba098",
                "values": [
                  {
                    "alias": "richtext",
                    "culture": "vi-VN",
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Ch2\u003E1. Thu th\u1EADp\u003C/h2\u003E\u003Cp\u003ETh\u00F4ng tin tr\u00ECnh duy\u1EC7t, cookies, d\u1EEF li\u1EC7u bi\u1EC3u m\u1EABu.\u003C/p\u003E\u003Ch2\u003E2. S\u1EED d\u1EE5ng\u003C/h2\u003E\u003Cp\u003EN\u00E2ng cao tr\u1EA3i nghi\u1EC7m, ph\u00E2n t\u00EDch l\u01B0u l\u01B0\u1EE3ng, b\u1EA3o m\u1EADt, li\u00EAn h\u1EC7.\u003C/p\u003E\u003Ch2\u003E3. B\u1EA3o m\u1EADt\u003C/h2\u003E\u003Cp\u003ECh\u00FAng t\u00F4i b\u1EA3o v\u1EC7 th\u00F4ng tin c\u1EE7a b\u1EA1n b\u1EB1ng c\u00E1c bi\u1EC7n ph\u00E1p ph\u00F9 h\u1EE3p.\u003C/p\u003E\u003Ch2\u003E4. Cookies\u003C/h2\u003E\u003Cp\u003ECh\u00FAng t\u00F4i s\u1EED d\u1EE5ng cookies. T\u00F9y ch\u1EC9nh trong c\u00E0i \u0111\u1EB7t tr\u00ECnh duy\u1EC7t.\u003C/p\u003E\u003Ch2\u003E5. Quy\u1EC1n c\u1EE7a b\u1EA1n\u003C/h2\u003E\u003Cp\u003ETruy c\u1EADp, s\u1EEDa \u0111\u1ED5i, x\u00F3a d\u1EEF li\u1EC7u; ph\u1EA3n \u0111\u1ED1i x\u1EED l\u00FD; r\u00FAt l\u1EA1i s\u1EF1 \u0111\u1ED3ng \u00FD.\u003C/p\u003E\u003Ch2\u003E6. Chia s\u1EBB\u003C/h2\u003E\u003Cp\u003EKh\u00F4ng b\u00E1n/chia s\u1EBB ngo\u1EA1i tr\u1EEB tr\u01B0\u1EDDng h\u1EE3p ph\u00E1p lu\u1EADt y\u00EAu c\u1EA7u.\u003C/p\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "76543210-edcb-a098-7654-321fedcba098",
