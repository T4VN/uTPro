        }
      ]
    },
    {
      "contentTypeKey": "7933a097-e795-4929-9746-d802b4ed8595",
      "key": "23456789-bcde-f012-3456-789abcdef012",
      "values": [
        {
          "alias": "title",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": "\u0110\u1ECBnh ngh\u0129a"
        },
        {
          "alias": "content",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "be80a795-b398-4baa-860a-ee68b7124f11",
                "key": "87654321-edcb-a098-7654-321fedcba098",
                "values": [
                  {
                    "alias": "richtext",
                    "culture": "vi-VN",
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Cp\u003ETrong c\u00E1c \u0110i\u1EC1u kho\u1EA3n n\u00E0y:\u003C/p\u003E\u003Cul\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003E\u0022Trang web\u0022\u003C/strong\u003E: Trang web v\u00E0 c\u00E1c d\u1ECBch v\u1EE5 c\u1EE7a uTPro.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003E\u0022Ng\u01B0\u1EDDi d\u00F9ng\u0022\u003C/strong\u003E: B\u1EA5t k\u1EF3 ai truy c\u1EADp v\u00E0o trang web.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003E\u0022Ch\u00FAng t\u00F4i\u0022\u003C/strong\u003E: \u0110\u1ED9i ng\u0169 uTPro.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003E\u0022N\u1ED9i dung\u0022\u003C/strong\u003E: V\u0103n b\u1EA3n, h\u00ECnh \u1EA3nh, m\u00E3 ngu\u1ED3n tr\u00EAn trang web.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003E\u0022D\u1ECBch v\u1EE5\u0022\u003C/strong\u003E: C\u00E1c t\u00EDnh n\u0103ng v\u00E0 c\u00F4ng c\u1EE5 \u0111\u01B0\u1EE3c cung c\u1EA5p.\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003E\u0022Ngu\u1ED3n m\u1EDF\u0022\u003C/strong\u003E: Ph\u1EA7n m\u1EC1m c\u00F3 th\u1EC3 s\u1EED d\u1EE5ng t\u1EF1 do.\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "87654321-edcb-a098-7654-321fedcba098",
                "culture": "vi-VN",
                "segment": null
              }
            ],
