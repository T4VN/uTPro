      "values": [
        {
          "alias": "thumbnail",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "description",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": "PostgreSQL, SQL Server v\u00E0 SQLite"
        },
        {
          "alias": "title",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": "C\u1EA5u h\u00ECnh Database"
        },
        {
          "alias": "content",
          "culture": "vi-VN",
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "be80a795-b398-4baa-860a-ee68b7124f11",
                "key": "d1f20005-3001-4000-b005-000000000001",
                "values": [
                  {
                    "alias": "richtext",
                    "culture": "vi-VN",
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Ch2\u003EC\u1EA5u h\u00ECnh Database Provider (PostgreSQL / SQL Server / SQLite)\u003C/h2\u003E\u003Cp\u003EuTPro ch\u1EA1y tr\u00EAn b\u1EA5t k\u1EF3 database engine n\u00E0o Umbraco 17 h\u1ED7 tr\u1EE3. Engine \u0111\u01B0\u1EE3c ch\u1ECDn b\u1EDFi hai key trong \u003Ccode\u003Eappsettings.json\u003C/code\u003E: \u003Ccode\u003EumbracoDbDSN\u003C/code\u003E v\u00E0 \u003Ccode\u003EumbracoDbDSN_ProviderName\u003C/code\u003E.\u003C/p\u003E\u003Cp\u003EuTPro \u0111\u01B0\u1EE3c c\u1EA5u h\u00ECnh s\u1EB5n cho \u003Cstrong\u003EPostgreSQL\u003C/strong\u003E. Chuy\u1EC3n sang SQL Server ho\u1EB7c SQLite ch\u1EC9 c\u1EA7n thay \u0111\u1ED5i hai key; kh\u00F4ng c\u1EA7n s\u1EEDa code.\u003C/p\u003E\u003Ctable\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EEngine\u003C/th\u003E\u003Cth\u003EProviderName\u003C/th\u003E\u003Cth\u003EPackage th\u00EAm\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003EPostgreSQL (m\u1EB7c \u0111\u1ECBnh)\u003C/td\u003E\u003Ctd\u003ENpgsql2\u003C/td\u003E\u003Ctd\u003EOur.Umbraco.PostgreSql (\u0111\u00E3 tham chi\u1EBFu s\u1EB5n)\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003ESQL Server\u003C/td\u003E\u003Ctd\u003EMicrosoft.Data.SqlClient\u003C/td\u003E\u003Ctd\u003Ekh\u00F4ng c\u1EA7n (t\u00EDch h\u1EE3p s\u1EB5n)\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003ESQLite\u003C/td\u003E\u003Ctd\u003EMicrosoft.Data.Sqlite\u003C/td\u003E\u003Ctd\u003Ekh\u00F4ng c\u1EA7n (t\u00EDch h\u1EE3p s\u1EB5n)\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E\u003Cp\u003EPostgreSQL provider \u0111\u01B0\u1EE3c \u0111\u0103ng k\u00FD \u003Cstrong\u003Ec\u00F3 \u0111i\u1EC1u ki\u1EC7n\u003C/strong\u003E trong \u003Ccode\u003EStartup/UmbracoSetup.cs\u003C/code\u003E: \u003Ccode\u003EAddUmbracoPostgreSqlSupport()\u003C/code\u003E ch\u1EC9 \u0111\u01B0\u1EE3c g\u1ECDi khi provider name ch\u1EE9a \u0022Npgsql\u0022. Khi chuy\u1EC3n engine, l\u1EC7nh n\u00E0y t\u1EF1 \u0111\u1ED9ng b\u1ECB b\u1ECF qua.\u003C/p\u003E\u003Ch3\u003EPostgreSQL (m\u1EB7c \u0111\u1ECBnh)\u003C/h3\u003E\u003Cp\u003ET\u1EA1o database PostgreSQL tr\u1ED1ng, sau \u0111\u00F3 c\u1EA5u h\u00ECnh connection string:\u003C/p\u003E\u003Cpre\u003E\u003Ccode\u003E\u0022ConnectionStrings\u0022: {\n  \u0022umbracoDbDSN\u0022: \u0022Server=localhost;Port=5432;Database=utpro;Username=postgres;Password=yourpass\u0022,\n  \u0022umbracoDbDSN_ProviderName\u0022: \u0022Npgsql2\u0022\n}\u003C/code\u003E\u003C/pre\u003E\u003Ch3\u003ESQL Server\u003C/h3\u003E\u003Cpre\u003E\u003Ccode\u003E\u0022ConnectionStrings\u0022: {\n  \u0022umbracoDbDSN\u0022: \u0022Server=.;Database=utpro;Integrated Security=true;TrustServerCertificate=true\u0022,\n  \u0022umbracoDbDSN_ProviderName\u0022: \u0022Microsoft.Data.SqlClient\u0022\n}\u003C/code\u003E\u003C/pre\u003E\u003Ch3\u003ESQLite\u003C/h3\u003E\u003Cpre\u003E\u003Ccode\u003E\u0022ConnectionStrings\u0022: {\n  \u0022umbracoDbDSN\u0022: \u0022Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True\u0022,\n  \u0022umbracoDbDSN_ProviderName\u0022: \u0022Microsoft.Data.Sqlite\u0022\n}\u003C/code\u003E\u003C/pre\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
