    },
    {
      "contentTypeKey": "7933a097-e795-4929-9746-d802b4ed8595",
      "key": "a2f10005-2001-4000-b005-000000000001",
      "values": [
        {
          "alias": "thumbnail",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "description",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "PostgreSQL, SQL Server and SQLite configuration"
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Database Provider"
        },
        {
          "alias": "content",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "be80a795-b398-4baa-860a-ee68b7124f11",
                "key": "a2f10005-3001-4000-b005-000000000001",
                "values": [
                  {
                    "alias": "richtext",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Ch2\u003EDatabase Provider (PostgreSQL / SQL Server / SQLite)\u003C/h2\u003E\u003Cp\u003EuTPro runs on any database engine Umbraco 17 supports. The engine is selected by two keys in \u003Ccode\u003Eappsettings.json\u003C/code\u003E: \u003Ccode\u003EumbracoDbDSN\u003C/code\u003E and \u003Ccode\u003EumbracoDbDSN_ProviderName\u003C/code\u003E.\u003C/p\u003E\u003Cp\u003EuTPro ships configured for \u003Cstrong\u003EPostgreSQL\u003C/strong\u003E out of the box. Switching to SQL Server or SQLite requires only changing two keys; no code changes.\u003C/p\u003E\u003Ctable\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EEngine\u003C/th\u003E\u003Cth\u003EProviderName\u003C/th\u003E\u003Cth\u003EExtra Package\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003EPostgreSQL (default)\u003C/td\u003E\u003Ctd\u003ENpgsql2\u003C/td\u003E\u003Ctd\u003EOur.Umbraco.PostgreSql (pre-referenced)\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003ESQL Server\u003C/td\u003E\u003Ctd\u003EMicrosoft.Data.SqlClient\u003C/td\u003E\u003Ctd\u003Enone (built-in)\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003ESQLite\u003C/td\u003E\u003Ctd\u003EMicrosoft.Data.Sqlite\u003C/td\u003E\u003Ctd\u003Enone (built-in)\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E\u003Cp\u003EThe PostgreSQL provider is registered \u003Cstrong\u003Econditionally\u003C/strong\u003E in \u003Ccode\u003EStartup/UmbracoSetup.cs\u003C/code\u003E: \u003Ccode\u003EAddUmbracoPostgreSqlSupport()\u003C/code\u003E is only called when the provider name contains \u0022Npgsql\u0022. When you switch engines, the call is skipped automatically.\u003C/p\u003E\u003Ch3\u003EPostgreSQL (default)\u003C/h3\u003E\u003Cp\u003ECreate an empty PostgreSQL database, then set the connection string:\u003C/p\u003E\u003Cpre\u003E\u003Ccode\u003E\u0022ConnectionStrings\u0022: {\n  \u0022umbracoDbDSN\u0022: \u0022Server=localhost;Port=5432;Database=utpro;Username=postgres;Password=yourpass\u0022,\n  \u0022umbracoDbDSN_ProviderName\u0022: \u0022Npgsql2\u0022\n}\u003C/code\u003E\u003C/pre\u003E\u003Ch3\u003ESQL Server\u003C/h3\u003E\u003Cpre\u003E\u003Ccode\u003E\u0022ConnectionStrings\u0022: {\n  \u0022umbracoDbDSN\u0022: \u0022Server=.;Database=utpro;Integrated Security=true;TrustServerCertificate=true\u0022,\n  \u0022umbracoDbDSN_ProviderName\u0022: \u0022Microsoft.Data.SqlClient\u0022\n}\u003C/code\u003E\u003C/pre\u003E\u003Ch3\u003ESQLite\u003C/h3\u003E\u003Cpre\u003E\u003Ccode\u003E\u0022ConnectionStrings\u0022: {\n  \u0022umbracoDbDSN\u0022: \u0022Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True\u0022,\n  \u0022umbracoDbDSN_ProviderName\u0022: \u0022Microsoft.Data.Sqlite\u0022\n}\u003C/code\u003E\u003C/pre\u003E"
                    }
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "a2f10005-3001-4000-b005-000000000001",
                "culture": "en-US",
                "segment": null
              }
            ],
            "layout": {
              "Umbraco.BlockList": [
