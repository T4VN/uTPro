    <content>
      <Value Culture="en-US"><![CDATA[{"contentData":[{"contentTypeKey":"4b83a788-622b-4210-afad-eac8988de0dd","key":"a2f30001-1001-4000-b003-000000000001","values":[{"alias":"backgroundColor","culture":"en-US","editorAlias":null,"segment":null,"value":{"label":"","value":"#fff"}},{"alias":"backgroundOpacity","culture":"en-US","editorAlias":null,"segment":null,"value":"1"},{"alias":"title","culture":"en-US","editorAlias":null,"segment":null,"value":""}]},{"contentTypeKey":"7933a097-e795-4929-9746-d802b4ed8595","key":"a2f30001-2001-4000-b003-000000000001","values":[{"alias":"thumbnail","culture":"en-US","editorAlias":null,"segment":null,"value":[]},{"alias":"description","culture":"en-US","editorAlias":null,"segment":null,"value":"Cookie-based language memory, Culture and Hostnames setup"},{"alias":"title","culture":"en-US","editorAlias":null,"segment":null,"value":"Language \u0026 Multilingual Configuration"},{"alias":"content","culture":"en-US","editorAlias":null,"segment":null,"value":{"contentData":[{"contentTypeKey":"be80a795-b398-4baa-860a-ee68b7124f11","key":"a2f30001-3001-4000-b003-000000000001","values":[{"alias":"richtext","culture":"en-US","editorAlias":null,"segment":null,"value":{"blocks":{"contentData":[],"settingsData":[],"expose":[],"layout":{}},"markup":"\u003Ch2\u003ELanguage \u0026 Multilingual Configuration\u003C/h2\u003E\u003Ch3\u003ECulture and Hostnames\u003C/h3\u003E\u003Cp\u003EuTPro provides multilingual configuration by \u003Cstrong\u003Ecookie\u003C/strong\u003E. You can find the \u0022Culture and Hostnames\u0022 settings in the \u0022Home\u0022 node (\u003Cstrong\u003EuTPro \u2192 Sites \u2192 Home\u003C/strong\u003E).\u003C/p\u003E\u003Cp\u003E\u003Cimg src=\u0022https://raw.githubusercontent.com/T4VN/uTPro/refs/heads/gh-pages/docs/screenshots/config-culture-hostnames.png\u0022 alt=\u0022Culture and Hostnames configuration\u0022 /\u003E\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EIMPORTANT:\u003C/strong\u003E Make sure that the default language (first access user has no cookie and url has no language set) is set to END \u0022/\u0022 by default and set it to the last position. Make sure each language has a hostname for Remember Language to work properly.\u003C/p\u003E\u003Cp\u003EYou can disable this feature by setting \u003Cstrong\u003EEnabled: \u0022false\u0022\u003C/strong\u003E for \u003Cstrong\u003ERememberLanguage\u003C/strong\u003E:\u003C/p\u003E\u003Cp\u003E\u003Cimg src=\u0022https://raw.githubusercontent.com/T4VN/uTPro/refs/heads/gh-pages/docs/screenshots/config-remember-language-disable.png\u0022 alt=\u0022Disable Remember Language\u0022 /\u003E\u003C/p\u003E\u003Ch3\u003EBackoffice and Website run separately\u003C/h3\u003E\u003Cp\u003EYou can separate Backoffice and Website into 2 separate domains. If you have enabled and configured the domain for Backoffice, try accessing the Website domain and \u0022/umbraco\u0022 to see the result.\u003C/p\u003E\u003Cp\u003E\u003Cimg src=\u0022https://raw.githubusercontent.com/T4VN/uTPro/refs/heads/gh-pages/docs/screenshots/config-backoffice-domain.png\u0022 alt=\u0022Backoffice domain configuration\u0022 /\u003E\u003C/p\u003E\u003Ch3\u003EuTPro Custom Configuration (appsettings.json)\u003C/h3\u003E\u003Ctable\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EKey\u003C/th\u003E\u003Cth\u003EDescription\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:Backoffice:Enabled\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003EEnable separate backoffice domain\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:Backoffice:Url\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003EBackoffice domain(s), comma-separated\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:RememberLanguage:Enabled\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003EEnable cookie-based language persistence\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:DefaultCulture\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003EFallback culture when no language cookie/URL is present\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E"}}]}],"settingsData":[],"expose":[{"contentKey":"a2f30001-3001-4000-b003-000000000001","culture":"en-US","segment":null}],"layout":{"Umbraco.BlockList":[{"contentKey":"a2f30001-3001-4000-b003-000000000001","contentUdi":null,"settingsKey":null,"settingsUdi":null}]}}}]}],"settingsData":[{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"a2f30001-4001-4000-b003-000000000001","values":[{"alias":"addStyleSpacing","culture":"en-US","editorAlias":null,"segment":null,"value":["Remove Spacing"]}]},{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"a2f30001-5001-4000-b003-000000000001","values":[]}],"expose":[{"contentKey":"a2f30001-1001-4000-b003-000000000001","culture":"en-US","segment":null},{"contentKey":"a2f30001-2001-4000-b003-000000000001","culture":"en-US","segment":null}],"layout":{"Umbraco.BlockGrid":[{"areas":[{"items":[{"areas":[],"columnSpan":12,"contentKey":"a2f30001-2001-4000-b003-000000000001","contentUdi":null,"rowSpan":1,"settingsKey":"a2f30001-5001-4000-b003-000000000001","settingsUdi":null}],"key":"74341b8e-afe1-47c5-bd24-d94b157e8a1c"}],"columnSpan":12,"contentKey":"a2f30001-1001-4000-b003-000000000001","contentUdi":null,"rowSpan":1,"settingsKey":"a2f30001-4001-4000-b003-000000000001","settingsUdi":null}]}}]]></Value>
      <Value Culture="vi-VN"><![CDATA[{"contentData":[{"contentTypeKey":"4b83a788-622b-4210-afad-eac8988de0dd","key":"d1f20001-1001-4000-b001-000000000001","values":[{"alias":"backgroundColor","culture":"vi-VN","editorAlias":null,"segment":null,"value":{"label":"","value":"#fff"}},{"alias":"backgroundOpacity","culture":"vi-VN","editorAlias":null,"segment":null,"value":"1"},{"alias":"title","culture":"vi-VN","editorAlias":null,"segment":null,"value":""}]},{"contentTypeKey":"7933a097-e795-4929-9746-d802b4ed8595","key":"d1f20001-2001-4000-b001-000000000001","values":[{"alias":"thumbnail","culture":"vi-VN","editorAlias":null,"segment":null,"value":[]},{"alias":"description","culture":"vi-VN","editorAlias":null,"segment":null,"value":"C\u1EA5u h\u00ECnh cookie ng\u00F4n ng\u1EEF, Culture and Hostnames"},{"alias":"title","culture":"vi-VN","editorAlias":null,"segment":null,"value":"C\u1EA5u h\u00ECnh Ng\u00F4n ng\u1EEF \u0026 \u0110a ng\u00F4n ng\u1EEF"},{"alias":"content","culture":"vi-VN","editorAlias":null,"segment":null,"value":{"contentData":[{"contentTypeKey":"be80a795-b398-4baa-860a-ee68b7124f11","key":"d1f20001-3001-4000-b001-000000000001","values":[{"alias":"richtext","culture":"vi-VN","editorAlias":null,"segment":null,"value":{"blocks":{"contentData":[],"settingsData":[],"expose":[],"layout":{}},"markup":"\u003Ch2\u003EC\u1EA5u h\u00ECnh Ng\u00F4n ng\u1EEF \u0026 \u0110a ng\u00F4n ng\u1EEF\u003C/h2\u003E\u003Ch3\u003ECulture and Hostnames\u003C/h3\u003E\u003Cp\u003EuTPro cung c\u1EA5p c\u1EA5u h\u00ECnh \u0111a ng\u00F4n ng\u1EEF b\u1EB1ng \u003Cstrong\u003Ecookie\u003C/strong\u003E. B\u1EA1n c\u00F3 th\u1EC3 t\u00ECm c\u00E0i \u0111\u1EB7t \u0022Culture and Hostnames\u0022 trong node \u0022Home\u0022 (\u003Cstrong\u003EuTPro \u2192 Sites \u2192 Home\u003C/strong\u003E).\u003C/p\u003E\u003Cp\u003E\u003Cimg src=\u0022https://raw.githubusercontent.com/T4VN/uTPro/refs/heads/gh-pages/docs/screenshots/config-culture-hostnames.png\u0022 alt=\u0022C\u1EA5u h\u00ECnh Culture and Hostnames\u0022 /\u003E\u003C/p\u003E\u003Cp\u003E\u003Cstrong\u003EQUAN TR\u1ECENG:\u003C/strong\u003E \u0110\u1EA3m b\u1EA3o ng\u00F4n ng\u1EEF m\u1EB7c \u0111\u1ECBnh (ng\u01B0\u1EDDi d\u00F9ng truy c\u1EADp l\u1EA7n \u0111\u1EA7u kh\u00F4ng c\u00F3 cookie) \u0111\u01B0\u1EE3c \u0111\u1EB7t cu\u1ED1i v\u1EDBi \u0022/\u0022 m\u1EB7c \u0111\u1ECBnh. M\u1ED7i ng\u00F4n ng\u1EEF ph\u1EA3i c\u00F3 hostname ri\u00EAng \u0111\u1EC3 Remember Language ho\u1EA1t \u0111\u1ED9ng.\u003C/p\u003E\u003Cp\u003EC\u00F3 th\u1EC3 t\u1EAFt t\u00EDnh n\u0103ng n\u00E0y b\u1EB1ng c\u00E1ch \u0111\u1EB7t \u003Cstrong\u003EEnabled: \u0022false\u0022\u003C/strong\u003E cho \u003Cstrong\u003ERememberLanguage\u003C/strong\u003E:\u003C/p\u003E\u003Cp\u003E\u003Cimg src=\u0022https://raw.githubusercontent.com/T4VN/uTPro/refs/heads/gh-pages/docs/screenshots/config-remember-language-disable.png\u0022 alt=\u0022T\u1EAFt Remember Language\u0022 /\u003E\u003C/p\u003E\u003Ch3\u003ET\u00E1ch Backoffice v\u00E0 Website\u003C/h3\u003E\u003Cp\u003EB\u1EA1n c\u00F3 th\u1EC3 t\u00E1ch Backoffice v\u00E0 Website th\u00E0nh 2 domain ri\u00EAng. Sau khi b\u1EADt v\u00E0 c\u1EA5u h\u00ECnh domain cho Backoffice, th\u1EED truy c\u1EADp domain Website k\u00E8m \u0022/umbraco\u0022 \u0111\u1EC3 ki\u1EC3m tra.\u003C/p\u003E\u003Cp\u003E\u003Cimg src=\u0022https://raw.githubusercontent.com/T4VN/uTPro/refs/heads/gh-pages/docs/screenshots/config-backoffice-domain.png\u0022 alt=\u0022C\u1EA5u h\u00ECnh domain Backoffice\u0022 /\u003E\u003C/p\u003E\u003Ch3\u003EC\u1EA5u h\u00ECnh t\u00F9y ch\u1EC9nh (appsettings.json)\u003C/h3\u003E\u003Ctable\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth\u003EKey\u003C/th\u003E\u003Cth\u003EM\u00F4 t\u1EA3\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:Backoffice:Enabled\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003EB\u1EADt t\u00E1ch domain backoffice\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:Backoffice:Url\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003EDomain backoffice, ph\u00E2n c\u00E1ch b\u1EB1ng d\u1EA5u ph\u1EA9y\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:RememberLanguage:Enabled\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003EB\u1EADt l\u01B0u ng\u00F4n ng\u1EEF theo cookie\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd\u003E\u003Ccode\u003EuTPro:DefaultCulture\u003C/code\u003E\u003C/td\u003E\u003Ctd\u003ECulture m\u1EB7c \u0111\u1ECBnh khi kh\u00F4ng c\u00F3 cookie/URL\u003C/td\u003E\u003C/tr\u003E\u003C/tbody\u003E\u003C/table\u003E"}}]}],"settingsData":[],"expose":[{"contentKey":"d1f20001-3001-4000-b001-000000000001","culture":"vi-VN","segment":null}],"layout":{"Umbraco.BlockList":[{"contentKey":"d1f20001-3001-4000-b001-000000000001","contentUdi":null,"settingsKey":null,"settingsUdi":null}]}}}]}],"settingsData":[{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"d1f20001-4001-4000-b001-000000000001","values":[{"alias":"addStyleSpacing","culture":"vi-VN","editorAlias":null,"segment":null,"value":["Remove Spacing"]}]},{"contentTypeKey":"d8c525b6-c39b-47f9-9e7e-6cc60eae7a17","key":"d1f20001-5001-4000-b001-000000000001","values":[]}],"expose":[{"contentKey":"d1f20001-1001-4000-b001-000000000001","culture":"vi-VN","segment":null},{"contentKey":"d1f20001-2001-4000-b001-000000000001","culture":"vi-VN","segment":null}],"layout":{"Umbraco.BlockGrid":[{"areas":[{"items":[{"areas":[],"columnSpan":12,"contentKey":"d1f20001-2001-4000-b001-000000000001","contentUdi":null,"rowSpan":1,"settingsKey":"d1f20001-5001-4000-b001-000000000001","settingsUdi":null}],"key":"74341b8e-afe1-47c5-bd24-d94b157e8a1c"}],"columnSpan":12,"contentKey":"d1f20001-1001-4000-b001-000000000001","contentUdi":null,"rowSpan":1,"settingsKey":"d1f20001-4001-4000-b001-000000000001","settingsUdi":null}]}}]]></Value>
