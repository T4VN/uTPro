<DataType Key="45a6b7c8-d9e0-4f12-a3b4-c5d6e7f80912" Alias="uTPro - Page Category Picker" Level="3">
  <Info>
    <Name>uTPro - Page Category Picker</Name>
    <EditorAlias>Umbraco.MultiNodeTreePicker</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.ContentPicker</EditorUIAlias>
    <Folder>uTPro</Folder>
  </Info>
  <Config><![CDATA[{
