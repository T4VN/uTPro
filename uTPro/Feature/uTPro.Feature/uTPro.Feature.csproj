<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Compile the MVC Razor partials shipped in this RCL (e.g. the Turnstile field view under
         Views/Partials/uTProSimpleForm/Fields) so the SimpleFormBuilder resolver can find them
         instead of falling back to _Default.cshtml. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="uTPro.Feature.AuditLog" Version="17.5.2" />
    <PackageReference Include="uTPro.Feature.FileManager" Version="17.6.2" />
    <PackageReference Include="uTPro.Feature.JobMonitor" Version="17.2.2" />
    <PackageReference Include="uTPro.Feature.SimpleFormBuilder" Version="17.5.2" />
    <PackageReference Include="uTPro.Feature.UrlViewer" Version="17.3.3" />
    <PackageReference Include="uTPro.Feature.SEOAudit" Version="17.2.2" />
    <PackageReference Include="uTPro.Feature.SearchPlus" Version="17.1.2" />
    <PackageReference Include="uTPro.Feature.GeoLocation" Version="17.1.1" />
    <PackageReference Include="uTPro.Feature.AIPageBuilder" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uTPro.Feature.Dashboard\uTPro.Feature.Dashboard.csproj" />
  </ItemGroup>

</Project>
